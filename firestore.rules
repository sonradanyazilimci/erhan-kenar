rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Site içeriği herkese açık okunur; sadece giriş yapmış admin yazabilir.
    match /pages/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blog/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
